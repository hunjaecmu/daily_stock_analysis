# ===================================
# daily_stock_analysis 한국어판 - 환경변수 설정 견본
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
# 진짜 키는 .env 에만 적고, 이 파일(.env.example)에는 절대 넣지 마세요.
#
# Windows 사용자: 패키지를 설치하기 전에 PowerShell 에서 먼저 아래 명령을 실행하세요.
#   $env:PYTHONUTF8='1'
# Windows 기본 문자 인코딩(cp949) 때문에 설치·실행 중 인코딩 오류가 나는 것을 막아 줍니다.
# 새 PowerShell 창을 열 때마다 다시 실행해야 해요.
# ===================================

# 관심종목 목록 (쉼표로 구분)
# 한국 주식은 종목번호 뒤에 시장 표시를 붙여요: .KS = 코스피(KOSPI), .KQ = 코스닥(KOSDAQ)
#   예) 삼성전자 005930.KS, SK하이닉스 000660.KS, 에코프로비엠 247540.KQ
# 중국 A주(600519 등), 홍콩(hk00700), 미국(AAPL) 종목도 함께 넣을 수 있어요.
STOCK_LIST=005930.KS,000660.KS

# Futu OpenD (증권사 보유 종목 가져오기, 중국·홍콩 증권사용)
# --portfolio futu 는 ACTIVE REAL NORMAL / MASTER 계좌의 중국 A주·홍콩·미국 주식 LONG 보유분만 읽습니다.
# futu-api 10.8 은 IPv4 만 지원해요. Docker 에서 호스트의 OpenD 에 연결할 때는 컨테이너 안의 127.0.0.1 을 쓰면 안 됩니다. 자세한 내용은 docs/full-guide.md (중국어)
# FUTU_OPEND_HOST=127.0.0.1
# FUTU_OPEND_PORT=11111
# FUTU_HK_REALTIME_SOURCE_PRIORITY=futu,longbridge,akshare,yfinance
# FUTU_SECURITY_FIRM=NONE          # 선택. 기본은 OpenD 가 자동 인식, 증권사를 직접 지정해도 됨
# FUTU_ACC_ID=                    # 선택. 양의 정수, 지정하면 그 실계좌만 읽음

# Anspire Open API Keys (여러 개 가능, 쉼표로 구분)
# 발급: https://open.anspire.cn/?share_code=QFBC0FYC
# 더 우선순위가 높은 OpenAI 호환 출처가 없으면, 조건에 맞을 때 이 키를 Anspire AI 모델 게이트웨이와 뉴스 검색에 함께 씁니다.
# 아래 게이트웨이와 모델은 이 프로젝트의 예시 설정이에요. 실제로 쓸 수 있는지는 Anspire 콘솔과 공식 문서를 확인하세요.
# 예시 게이트웨이: https://open-gateway.anspire.cn/v6
# 예시 모델: Doubao-Seed-2.0-lite (ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-pro 로 바꿀 수 있음)
# 지역·버전에 따라 게이트웨이가 다르면 ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.ai/v6 로 바꿀 수 있음
ANSPIRE_API_KEYS=
# ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
# ANSPIRE_LLM_ENABLED=true
# 데이터 출처 설정
# Tushare Pro Token (선택, 중국 주식용. https://tushare.pro/weborder/#/login?reg=834638 에서 발급)
TUSHARE_TOKEN=
# Tushare Pro 접속 주소 직접 지정 (선택, 기본값 http://api.tushare.pro)
# 쓰는 경우: 공식 주소에 바로 접속할 수 없어 자체 게이트웨이나 호환 미러를 쓸 때
# 주의: 비공식 주소를 쓰면 Token 과 모든 요청 내용이 그 제3자 서버를 거칩니다. 보안 위험을 직접 판단하세요.
# 반드시 http:// 또는 https:// 로 시작해야 하고, 비워 두면 공식 기본 주소를 그대로 씁니다.
# TUSHARE_HTTP_URL=http://api.tushare.pro
# TickFlow API Key (선택. 중국 A주 일봉·실시간 시세·종목 목록/이름·시장 리뷰 보강용, 권한이 부족하면 자동으로 다른 출처 사용)
# TICKFLOW_API_KEY=
# TICKFLOW_KLINE_ADJUST=none          # none/forward/backward/forward_additive/backward_additive
# TICKFLOW_BATCH_DAILY_ENABLED=true   # 권한이 있으면 TickFlow 로 일봉을 한꺼번에 미리 받음
# TICKFLOW_BATCH_SIZE=100             # TickFlow 한 번 요청에 담는 최대 종목 수
# MiaoXiang(동방재부 MX_API) API Key — 직접 켜야만 동작하는 외부 기능이에요. Key 는 직접 준비해야 합니다(MiaoXiang Skills 페이지에서 발급).
# 지금의 기간 한정 무료/회원 한도 정책은 바뀔 수 있고 계속 무료라는 보장은 없어요. 설정하지 않으면 동작은 전혀 달라지지 않습니다.
# 설정하면: 동방재부 공개 API 가 막힐 때 매물대 분포와 종목별 자금 흐름을 대신 가져옵니다.
# MX_APIKEY=
# MX_PRIORITY=6                       # MiaoXiang 데이터 출처 우선순위, 기본 6 (내장 출처들 다음)

# 종목 발굴(스크리닝) (AlphaSift 방식 참고, 기본은 꺼짐. 보통 Web 의 "기본 설정"에 있는 종목 발굴 스위치로 관리)
SCREENING_ENABLED=false
# 전체 시장 스냅샷 출처 우선순위. 설정하지 않으면 TUSHARE_TOKEN 유무에 따라 DSA 가 자동으로 정합니다:
# - TUSHARE_TOKEN 있음: tushare,sina,efinance,akshare_em,em_datacenter
# - TUSHARE_TOKEN 없음: sina,efinance,akshare_em,em_datacenter
# SNAPSHOT_SOURCE_PRIORITY=tushare,sina,efinance,akshare_em,em_datacenter
# (실행 중 자동으로 정해지는 값과 같게 두려면 비워 두고, 이 파일에 값을 고정하지 마세요)
# 종목 발굴 시 외부 데이터 출처 호출 제한 시간.
# - SCREENING_SOURCE_CALL_TIMEOUT_SEC 는 전체 기본값이에요. 0/off/disabled 로 두면 호출 쪽 제한 시간을 끕니다.
# - Hotspot/SNAPSHOT/Daily 개별 값이 전체 값보다 우선이고, 기본은 각각 8초 / 60초 / 20초입니다.
# - 핫이슈 기본 provider 는 양수 값을 업종/구성 종목/상세 대체 호출 한 번의 시간 예산으로 쓰고, 남은 시간을 중단 가능한
#   AkShare 하위 프로세스와 HTTP 소켓에 넘깁니다. 0/off 는 전체 호출 예산만 끄고, 출처별 강제 제한 시간은 그대로 남습니다.
# SCREENING_SOURCE_CALL_TIMEOUT_SEC=
# SCREENING_HOTSPOT_CALL_TIMEOUT_SEC=8
# 사용자가 직접 핫이슈 뉴스를 검색할 때 전체 대기 시간 상한 (캐시 대기와 provider 실행 포함).
# 이 경로에는 반드시 강제 종료 시한이 있어야 해서, 0/off 로 두면 안전한 기본값 12초로 돌아갑니다.
# SCREENING_HOTSPOT_SEARCH_TIMEOUT_SEC=12
# SCREENING_SNAPSHOT_CALL_TIMEOUT_SEC=60
# SCREENING_DAILY_CALL_TIMEOUT_SEC=20
# 종목 발굴 시 동방재부(Eastmoney) 직접 요청 간격 제한과 무작위 지연.
# SCREENING_EASTMONEY_MIN_INTERVAL_SEC=1.0
# SCREENING_EASTMONEY_JITTER_SEC=0.3
# 종목 발굴은 마지막 정상 스냅샷, 일봉 기록, 업종/테마 provider 캐시를 저장하며 기본 폴더는 data/screening 입니다.
# 바꾸려면 아래 경로를 덮어쓰세요. 비워 두면 기존 DSA 설정은 바뀌지 않습니다.
# SCREENING_DATA_DIR=data/screening
# SCREENING_FALLBACK_SNAPSHOT_PATH=data/screening/snapshot.last_good.json
# 5분 안에 다시 종목 발굴을 하면 최근에 성공한 전체 시장 스냅샷을 재사용합니다. 0으로 두면 끕니다.
# SCREENING_SNAPSHOT_CACHE_TTL_SEC=300
# SCREENING_DAILY_HISTORY_CACHE_DIR=data/screening/daily_history
# 일봉 캐시는 기본 24시간 유지되고 가장 최근 마감된 거래일까지 담고 있어야 해요. 장 마감 전에 만든 캐시는 마감 후 새로 받습니다.
# 거래일 달력을 못 쓰면 유지 시간으로만 판단하고, 새로 받기에 실패하면 옛 일봉을 쓰되 품질 점수와 위험 감점에 반영합니다.
# SCREENING_INDUSTRY_PROVIDER_CACHE_DIR=data/screening/industry_provider_cache
# 종목 발굴의 업종/테마 provider 는 기본 꺼짐. akshare 로 켜면 theme_heat, 업종 열기, LLM 참고 자료에 업종 정보가 더 들어갑니다.
# INDUSTRY_PROVIDER=none
# INDUSTRY_PROVIDER_MAX_BOARDS=80
# LLM 요청 한 번의 제한 시간(초). 종목 발굴도 이 값을 쓰고, 시간을 넘기면 LLM 없이 정렬한 결과를 돌려줍니다.
# LLM_TIMEOUT_SEC=60
# 종목 발굴 LLM 재정렬 요청의 출력 상한, 기본 2048.
# LLM_MAX_TOKENS=2048

# Finnhub (선택, 미국 주식 데이터, 무료 등급 분당 60회)
# 발급: https://finnhub.io/register
# FINNHUB_API_KEY=

# AlphaVantage (선택, 미국 주식 데이터, 무료 등급 하루 25회)
# 발급: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Longbridge OpenAPI (선택, 미국·홍콩 주식의 거래량 비율·회전율·PER 등 보충)
# 발급: https://open.longbridge.com/
# OAuth 2.0 (권장): 먼저 scripts/generate_longbridge_oauth_token.py 를 실행해 이 컴퓨터에 SDK token 캐시를 만드세요
# client_id 는 LONGBRIDGE_OAUTH_CLIENT_ID 를 먼저 쓰고, 비어 있고 Legacy Access Token 도 없으면 LONGBRIDGE_APP_KEY 를 씁니다
# GitHub Actions / Docker 에서는 token 캐시 파일을 base64 로 바꿔 LONGBRIDGE_OAUTH_TOKEN_CACHE_B64 에 넣으면 됩니다
# LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# Legacy API Key (예전 계정용. 여기의 Access Token 은 OAuth access token 과 다릅니다)
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# static_info 를 메모리에 보관하는 시간(초), 기본 86400. 0 이면 요청마다 새로 받음
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# 연결이 끊기는 오류 뒤 쉬는 시간(초), 기본 15. 그동안은 Longbridge 를 잠시 건너뛰어 잦은 재연결을 막습니다
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15
# Longbridge SDK 언어는 REPORT_LANGUAGE(zh/en)를 따르고, SDK 로그는 LOG_DIR/longbridge_sdk.log 에 기록됩니다
# 접속 주소 (REPORT_LANGUAGE 와는 무관. 비워 두면 아래 기본값 사용):
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# 접속 지역 덮어쓰기. SDK 내부에서는 LONGPORT_REGION(BRIDGE 없음)으로 자동 선택하며,
# 코드가 LONGBRIDGE_REGION → LONGPORT_REGION 으로 자동으로 맞춰 줍니다.
# hk → *.longbridge.com  |  cn → *.longbridge.cn
# 나머지는 https://open.longbridge.com/zh-CN/docs/getting-started 의 환경변수 항목 참고
# 야간 거래 시세 true/false, 기본 false
# LONGBRIDGE_ENABLE_OVERNIGHT=false
# 캔들(K선) 푸시 방식 realtime 또는 confirmed, 기본 realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# 연결할 때 시세 패킷을 출력할지 여부 (설정하지 않으면 꺼짐 = false)
# 1 / true / yes 로 두면 SDK 시세 패킷 로그를 자세히 남깁니다 (Longbridge 연결 문제를 살펴볼 때)
# LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# 종목 자동완성 목록을 인터넷에서 갱신 (기본 켜짐. GitHub 에 접속할 수 없으면 내장 목록 사용)
STOCK_INDEX_REMOTE_UPDATE_ENABLED=true

# ===================================
# AI 모델 설정
# ===================================
# 자세한 설명: docs/LLM_CONFIG_GUIDE.md (중국어)
#
# [빠른 시작] 모델 연결 방식 하나만 고르세요. 뉴스 검색 Key 는 따로 설정합니다.
#   Modelflare (OpenAI 호환) → MODELFLARE_KEY 만 넣으면 기본 주소와 모델을 자동 사용
#   Gemini (무료 한도 있음) → GEMINI_API_KEY 입력 (이 한국어판의 기본 방식)
#   DeepSeek (저렴한 편) → DEEPSEEK_API_KEY 입력
#   AIHubmix (여러 모델을 모아 둔 플랫폼) → AIHUBMIX_KEY 입력
#
# [고급] 여러 모델·플랫폼을 예비로 돌려 쓰려면 아래 "여러 채널 설정"을 쓰거나 Web 설정 화면에서 관리하세요.
# 채널마다 LLM_<CHANNEL>_API_SURFACE 로 chat_completions(기본) 또는 responses 를 고를 수 있어요.
# responses 는 PROTOCOL=openai 여야 하고, MODELS 에 anthropic/, gemini/, xai/ 같은 LiteLLM 직접 연결 접두어를 쓸 수 없습니다.
# 게이트웨이 고유의 슬래시가 들어간 모델 ID(예: deepseek-ai/DeepSeek-V3)는 OpenAI 호환 모델 ID 로 처리됩니다.
# 같은 모델 별칭을 chat_completions 채널과 responses 채널에 동시에 둘 수 없어요. 둘 다 필요하면 별칭을 다르게 쓰세요.
# 한 채널 안의 모델은 같은 API Surface 를 써야 하고, 실패했을 때 endpoint 가 자동으로 바뀌길 기대하면 안 됩니다.
# Anspire `/models` 와 연결 테스트에서 모델이 Responses 방식으로 확인되면(예: 현재 확인된 GPT-5.6 sol/terra/luna), 채널 방식으로 LLM_ANSPIRE_API_SURFACE=responses 를 설정하세요.
# ===================================

# 생성 백엔드: 기본 litellm. codex_cli / claude_code_cli / opencode_cli 는 직접 켜야 하는 내 컴퓨터 CLI 백엔드입니다 (실험적/제한적).
# OpenCode CLI 는 이 컴퓨터 OpenCode 의 기본 모델을 쓰고, OPENCODE_CLI_MODEL 은 --model 을 바꾸고 싶을 때만 씁니다.
# 내 컴퓨터 CLI 백엔드라고 오프라인 모델은 아니에요. CLI 뒤의 서비스가 종목 코드, 뉴스, 보유 종목 정보, 분석 prompt, 보고서 초안을 처리할 수 있습니다.
# Docker / CI / 원격 서버에는 데스크톱 CLI 로그인 상태가 없고, DSA 는 Claude/OpenCode 인증 파일을 읽지 않습니다.
# DSA 는 꼭 필요한 환경변수만 넘기고 provider 인증 정보는 막아서 API key / webhook token 이 새어 나갈 위험을 줄입니다.
# Web 설정 화면의 빠른 확인은 설정과 실행 파일 유무만 보고, JSON 테스트를 해야 실제 생성 백엔드에 시험 요청을 보냅니다.
GENERATION_BACKEND=litellm
# OPENCODE_CLI_MODEL=provider/model
# 백엔드 단위 예비 설정. 내 .env 에서 비워 두면 꺼지고, litellm -> litellm 은 아무 일도 하지 않습니다.
# 기본 GitHub Actions workflow 에서는 이 값이 없으면 litellm 을 씁니다. Actions 에서 끄려면 기본 백엔드와 같은 값으로 두세요.
GENERATION_FALLBACK_BACKEND=litellm
# 내 컴퓨터 CLI 백엔드 실행 한도. timeout 최대 3600, 출력 최대 33554432 bytes, 동시 실행 최대 각각 16 / 4.
GENERATION_BACKEND_TIMEOUT_SECONDS=300
GENERATION_BACKEND_MAX_OUTPUT_BYTES=1048576
GENERATION_BACKEND_MAX_CONCURRENCY=1
LOCAL_CLI_BACKEND_MAX_CONCURRENCY=1
# 종목 질문 채팅 실행 방식. auto(권장)와 litellm 은 기본 LiteLLM 을 씁니다. 예전 codex_app_server 는 없어졌으니 다른 값으로 바꿔야 해요. codex_cli 로 만드는 일반 보고서는 영향 없음.
AGENT_BACKEND=auto
# 예전 Agent 모델 연결 호환용 항목. 일반 사용자는 Web 설정 화면의 AGENT_BACKEND 를 쓰세요.
AGENT_GENERATION_BACKEND=auto

# --- API Key (하나만 넣으면 됩니다) ---

# Gemini (https://aistudio.google.com/apikey 에서 무료 발급)
GEMINI_API_KEY=
# 사용할 Gemini 모델. 원래 프로젝트 기본값 gemini-3.1-pro-preview 는 Gemini 무료 등급에서 쓸 수 없어서,
# 한국어판은 무료 등급에서 되는 gemini-3-flash-preview 를 기본으로 둡니다.
GEMINI_MODEL=gemini-3-flash-preview
# 기본 모델이 실패할 때 쓸 예비 모델 (GitHub Actions 기본값과 같음)
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash
# 키를 여러 개 돌려 쓰려면: GEMINI_API_KEYS=key1,key2,key3

# DeepSeek (https://platform.deepseek.com)
# 호환 기본값: DEEPSEEK_API_KEY 만 넣으면 deepseek-chat 을 쓰고, 로그에서 deepseek-v4-flash 로 옮기라고 안내합니다
# DEEPSEEK_API_KEY=

# AIHubmix 모음 플랫폼 (https://inferera.com/?aff=CfMq)
# Key 하나로 GPT/Claude/Gemini/GLM/Qwen 등 여러 모델 사용
# AIHUBMIX_KEY=

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=

# OpenAI / 호환 API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # 제3자 API 주소(중계·프록시), 비워 두면 공식 주소

# Ollama 내 컴퓨터 모델 (API Key 필요 없음)
# OLLAMA_API_BASE=http://localhost:11434
# LITELLM_MODEL=ollama/qwen3:8b
#
# 또는 채널 방식:
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b

# 샘플링 온도 (0.0-2.0, 기본 0.7. 0 이면 가장 일정하고, 2 면 가장 무작위)
# temperature 규칙이 엄격한 모델의 근거 자료:
# - Moonshot API / 모델 문서: https://platform.kimi.ai/docs/guide/kimi-k2-6-quickstart
# - Moonshot 공식 모델 카드 (평가 기본 temperature = 1.0): https://huggingface.co/moonshotai/Kimi-K2.6
# - OpenAI Chat Completions 규격: https://platform.openai.com/docs/api-reference/chat/create
# - LiteLLM OpenAI 호환 규격: https://docs.litellm.ai/docs/providers/openai_compatible
# 현재 저장소의 의존성 조건: litellm>=1.80.10,!=1.82.7,!=1.82.8,<1.99.0 (PyPI 사고 버전은 빼고 상한은 검증된 버전까지, requirements.txt 참고).
# 그래서 kimi-k2.6 은 자동으로 1.0/0.6 을 쓰고, GPT-5 / o 시리즈처럼 온도가 고정된 모델은 temperature 를 빼고 보내 API 가 요청을 거절하지 않게 합니다.
# 호환 플랫폼이 "지원하지 않는 매개변수" 오류를 분명히 돌려주면, 그 요청 안에서 매개변수를 고쳐 한 번 다시 시도합니다. 성공한 방식은 실행 중에만 기억합니다.
# top_p, presence_penalty, frequency_penalty, seed 도 "지원하지 않음"이 오면 같은 방식으로 그 요청만 고쳐 다시 시도합니다 (LLM_TEMPERATURE 는 바꾸지 않음).
# 다른 모델과 예비 모델은 설정한 LLM_TEMPERATURE 를 그대로 씁니다.
# Web 설정 화면이나 데스크톱 앱에서 가져올 때 LLM_TEMPERATURE 를 몰래 지우거나 바꾸지 않고, 실제 요청 직전에만 잠깐 맞춥니다.
# 기본 모델을 일반 모델로 되돌리면 원래 온도가 자동으로 돌아옵니다. 가장 간단히 되돌리려면 이번 LLM 매개변수 조정 변경을 되돌리면 됩니다.
# LLM_TEMPERATURE=0.7

# LLM 사용량 기록용 message HMAC 설정 (선택)
# 비워 두면 데이터 폴더에 .llm_usage_hmac_secret 을 만들어, 같은 설치 안에서는 일관되게 비교할 수 있어요.
# 여러 설치 사이에서 비교해야 할 때만 같은 무작위 비밀값을 직접 넣고, 바꿀 때는 버전 표시도 함께 바꾸세요.
# 직접 넣을 때는 충분히 무작위인 값(예: openssl rand -hex 32)을 쓰고, 실제 비밀값을 git 에 올리지 마세요.
# LLM_USAGE_HMAC_SECRET=
# LLM_USAGE_HMAC_KEY_VERSION=local-v1

# Provider prompt cache 설정 (선택)
# TELEMETRY 는 provider 캐시 사용량/진단 기록만 정하고, provider 가 알아서 하는 캐시는 바꾸지 않습니다.
# HINTS 는 prompt_cache_key, cache_control, user_id 같은 검증된 provider 전용 힌트를 보낼지 정하며 기본은 꺼짐.
# DIAGNOSTICS_LEVEL 은 off/basic/debug 중 하나. debug 여도 민감 정보를 가린 진단만 남기고 원본 prompt 나 요청 내용은 기록하지 않습니다.
# LLM_PROMPT_CACHE_TELEMETRY_ENABLED=true
# LLM_PROMPT_CACHE_HINTS_ENABLED=false
# LLM_PROMPT_CACHE_DIAGNOSTICS_LEVEL=off

# --- 여러 채널 설정 (선택, Web 설정 화면에서도 가능) ---
# 채널마다 base_url / api_key / models 를 따로 정하고, Key 여러 개 돌려 쓰기와 자동 예비 전환을 지원합니다.
#
# 예시: DeepSeek + Gemini 두 채널
# LLM_CHANNELS=deepseek,gemini
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LLM_GEMINI_API_KEYS=key1,key2
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview
#
# 예시: 직접 지정한 API 주소 (제3자 프록시 / 모음 플랫폼 / 중계 서버)
# LLM_CHANNELS=my_proxy
# LLM_MY_PROXY_BASE_URL=https://your-proxy.example.com/v1
# LLM_MY_PROXY_API_KEY=sk-xxx
# LLM_MY_PROXY_MODELS=gpt-5.5,claude-sonnet-4-6
# LLM_MY_PROXY_PROTOCOL=openai
#
# 예시: Ollama 내 컴퓨터 모델 (API Key 필요 없음)
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b,llama3.2
#
# 예시: Hermes 내 컴퓨터 HTTP 생성 (Phase 3, 일반 분석/JSON 만. Agent tools, Stream, Vision 은 지원 안 함)
# LLM_CHANNELS=hermes
# LLM_HERMES_PROTOCOL=openai
# LLM_HERMES_BASE_URL=http://127.0.0.1:8642/v1
# LLM_HERMES_API_KEY=sk-local-hermes
# LLM_HERMES_MODELS=hermes-agent
# LITELLM_MODEL=openai/hermes-agent
#
# 자주 쓰는 업체별 견본 (하나 골라 .env 에 복사. 자세한 설명은 docs/llm-providers.md, 중국어)
#
# Modelflare (OpenAI 호환)
# 가입: https://modelflare.dev/sign-up?utm_source=github&utm_campaign=daily_stock_analysis
# 단일 채널 기본 모델은 gpt-6.1-sol. 실제로 쓸 수 있는지는 계정 권한·콘솔·연결 테스트로 확인하세요.
# 이 Key 하나만 넣으면 되고, 채널 이름·주소·모델은 안 적어도 됩니다:
MODELFLARE_KEY=
# 고급 덮어쓰기 (선택):
# LLM_CHANNELS=modelflare
# LLM_MODELFLARE_API_KEY=sk-xxx
# 고급 선택: LLM_MODELFLARE_MODELS=  # 직접 적은 채널 목록이 우선이고, 채널이 여러 개면 모델을 각각 적어야 함
# 선택 덮어쓰기: LLM_MODELFLARE_BASE_URL=https://modelflare.dev/v1
# 선택 프로토콜: LLM_MODELFLARE_PROTOCOL=openai
# 기본 프로토콜 openai, 방식 chat_completions. 단일 채널에서 주 모델과 모델 목록이 없으면 gpt-6.1-sol 을 씁니다.
#
# AIHubmix 모음 플랫폼 (OpenAI 호환)
# LLM_CHANNELS=aihubmix
# LLM_AIHUBMIX_PROTOCOL=openai
# LLM_AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# LLM_AIHUBMIX_API_KEY=sk-xxx
# LLM_AIHUBMIX_MODELS=gpt-5.5,claude-sonnet-4-6,gemini-3.1-pro-preview
# LITELLM_MODEL=openai/gpt-5.5
#
# OpenAI 공식
# LLM_CHANNELS=openai
# LLM_OPENAI_PROTOCOL=openai
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=sk-xxx
# LLM_OPENAI_MODELS=gpt-5.5,gpt-5.4-mini
# LITELLM_MODEL=openai/gpt-5.5
#
# DeepSeek 공식
# LLM_CHANNELS=deepseek
# LLM_DEEPSEEK_PROTOCOL=deepseek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LITELLM_MODEL=deepseek/deepseek-v4-flash
#
# Gemini 공식 (공식 프로토콜, Base URL 은 비워 둠. 무료 등급이면 gemini-3-flash-preview 를 쓰세요)
# LLM_CHANNELS=gemini
# LLM_GEMINI_PROTOCOL=gemini
# LLM_GEMINI_API_KEY=xxx
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview
# LITELLM_MODEL=gemini/gemini-3.1-pro-preview
#
# Anthropic Claude 공식 (공식 프로토콜, Base URL 은 비워 둠)
# LLM_CHANNELS=anthropic
# LLM_ANTHROPIC_PROTOCOL=anthropic
# LLM_ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-7
# LITELLM_MODEL=anthropic/claude-sonnet-4-6
#
# Kimi / Moonshot (OpenAI 호환)
# LLM_CHANNELS=moonshot
# LLM_MOONSHOT_PROTOCOL=openai
# LLM_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# LLM_MOONSHOT_API_KEY=sk-xxx
# LLM_MOONSHOT_MODELS=kimi-k2.6,kimi-k2.5
# LITELLM_MODEL=openai/kimi-k2.6
#
# Qwen DashScope (OpenAI 호환)
# LLM_CHANNELS=dashscope
# LLM_DASHSCOPE_PROTOCOL=openai
# LLM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DASHSCOPE_API_KEY=sk-xxx
# LLM_DASHSCOPE_MODELS=qwen3.6-plus,qwen3.6-flash
# LITELLM_MODEL=openai/qwen3.6-plus
#
# Zhipu GLM (OpenAI 호환)
# LLM_CHANNELS=zhipu
# LLM_ZHIPU_PROTOCOL=openai
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_ZHIPU_API_KEY=xxx
# LLM_ZHIPU_MODELS=glm-5.1,glm-4.7-flash
# LITELLM_MODEL=openai/glm-5.1
#
# MiniMax (OpenAI 호환)
# 출처: 공식 OpenAI API 호환 문서 https://platform.minimax.io/docs/api-reference/text-chat
# LiteLLM 은 openai/<model> 로 Chat Completions 호환 Base URL 에 연결합니다.
# LLM_CHANNELS=minimax
# LLM_MINIMAX_PROTOCOL=openai
# LLM_MINIMAX_BASE_URL=https://api.minimax.io/v1
# LLM_MINIMAX_API_KEY=xxx
# LLM_MINIMAX_MODELS=MiniMax-M2.7,MiniMax-M2.7-highspeed
# LITELLM_MODEL=openai/MiniMax-M2.7
#
# Xiaomi MiMo (OpenAI 호환)
# Base URL 과 모델 이름은 MiMo 공식 문서/콘솔을 확인하세요.
# LLM_CHANNELS=mimo
# LLM_MIMO_PROTOCOL=openai
# LLM_MIMO_BASE_URL=
# LLM_MIMO_API_KEY=sk-xxx
# LLM_MIMO_MODELS=mimo-xxx
# LITELLM_MODEL=openai/mimo-xxx
# 참고: 기본 daily_analysis workflow 는 LLM_MIMO_* 를 넘기지 않아서, 이 예시는 내 .env, Docker, 직접 운영하는 스크립트용입니다. Actions 에서 쓰려면 workflow 에도 추가하세요.
#
# Volcengine Ark / Doubao (OpenAI 호환, 실제 개통 지역에 맞게 endpoint 조정)
# 출처: Volcengine Ark 온라인 추론 / Responses API 문서 https://www.volcengine.com/docs/82379/2121998
# LiteLLM 은 openai/<model> 로 Chat Completions 호환 Base URL 에 연결합니다.
# LLM_CHANNELS=volcengine
# LLM_VOLCENGINE_PROTOCOL=openai
# LLM_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_VOLCENGINE_API_KEY=xxx
# LLM_VOLCENGINE_MODELS=doubao-seed-1-6-251015,doubao-seed-1-6-thinking-251015
# LITELLM_MODEL=openai/doubao-seed-1-6-251015
#
# SiliconFlow (OpenAI 호환)
# 출처: 공식 모델 목록 https://docs.siliconflow.cn/quickstart/models
# LLM_CHANNELS=siliconflow
# LLM_SILICONFLOW_PROTOCOL=openai
# LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM_SILICONFLOW_API_KEY=sk-xxx
# LLM_SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3.2,Qwen/Qwen3-235B-A22B-Thinking-2507
# LITELLM_MODEL=openai/deepseek-ai/DeepSeek-V3.2
#
# OpenRouter (OpenAI 호환)
# 출처: 공식 Models API https://openrouter.ai/docs/api/api-reference/models/get-models
# LLM_CHANNELS=openrouter
# LLM_OPENROUTER_PROTOCOL=openai
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_API_KEY=sk-or-xxx
# LLM_OPENROUTER_MODELS=~anthropic/claude-sonnet-latest,~openai/gpt-latest
# LITELLM_MODEL=openai/~anthropic/claude-sonnet-latest
#
# Requesty (OpenAI 호환)
# 출처: 공식 Models API https://docs.requesty.ai/api-reference/endpoint/models-list
# 예시 모델은 슬래시 없는 managed 모델 ID 예요. Base URL 이 requesty.ai 이면 vendor/model ID(예: anthropic/claude-sonnet-4-6)에 openai/ 경로를 자동으로 붙여 그대로 보내고, Web "모델 가져오기"에서 고르면 openai/<vendor>/<model> 로 저장됩니다.
# openai/ 로 시작하는 ID 는 LiteLLM 경로 접두어와 겹쳐서, 직접 적을 때는 openai/openai/gpt-4o-mini 처럼 써야 합니다.
# EU 지역은 Base URL 을 https://router.eu.requesty.ai/v1 로 바꾸면 됩니다.
# LLM_CHANNELS=requesty
# LLM_REQUESTY_PROTOCOL=openai
# LLM_REQUESTY_BASE_URL=https://router.requesty.ai/v1
# LLM_REQUESTY_API_KEY=xxx
# LLM_REQUESTY_MODELS=claude-sonnet-4-6,gpt-5.4
# LITELLM_MODEL=openai/claude-sonnet-4-6

# Anspire Open 호환 예시 (검색과 LLM 이 같은 Key 사용, OpenAI 호환)
# LLM_CHANNELS=anspire
# LLM_ANSPIRE_PROTOCOL=openai
# LLM_ANSPIRE_BASE_URL=https://open-gateway.anspire.cn/v6  # 예시 게이트웨이
# LLM_ANSPIRE_API_KEY=sk-xxx
# LLM_ANSPIRE_MODELS=Doubao-Seed-2.0-lite,Doubao-Seed-2.0-pro  # 예시 모델
# LITELLM_MODEL=openai/Doubao-Seed-2.0-lite  # 예시 주 모델

# 고급: 모델 연결 YAML 설정 (선택, docs/examples/litellm_config.example.yaml 참고)
# LITELLM_CONFIG=./litellm_config.yaml

# ===================================
# 뉴스 검색 설정 (종목 뉴스를 가져올 때 사용)
# ===================================
# Bocha API Keys (중국어 검색에 맞춘 서비스, AI 요약 지원, 여러 개는 쉼표로 구분)
# 발급: https://open.bocha.cn/
# BOCHA_API_KEYS=your_bocha_key_here
# MiniMax API Key (Coding Plan Web Search, 여러 개는 쉼표로 구분)
# 발급: https://platform.minimax.io/
# MINIMAX_API_KEYS=your_minimax_key_here
# Tavily API Keys (여러 개는 쉼표로 구분)
# 한국 종목 뉴스 검색에 추천해요. https://tavily.com 에서 무료로 가입 (월 1,000 크레딧)
TAVILY_API_KEYS=
# SerpAPI Keys (여러 개는 쉼표로 구분)
SERPAPI_API_KEYS=
# Brave Search API Keys (여러 개는 쉼표로 구분)
# 발급: https://brave.com/search/api/
BRAVE_API_KEYS=
# SearXNG 서버 주소 (쉼표로 구분. 직접 운영하면 한도가 없고, settings.yml 에서 format: json 을 켜야 함)
# GitHub Actions 매일 분석 workflow 는 같은 이름의 Variables 를 먼저, 없으면 Secrets 를 읽습니다. 공개 주소는 Variable 로 넣어도 됩니다.
# 비워 두고 아래 스위치를 true 로 두면 searx.space 에서 공개 서버를 자동으로 가져옵니다. 공개 서버는 요청 제한(429),
# 서버 중단(503), JSON 출력 미지원이 흔해서 하나씩 다시 시도하다 보면 분석마다 30~60초가 더 걸리고 뉴스는 결국 비어 버립니다.
# 그래서 기본은 꺼짐입니다. 직접 운영하는 서버 주소(SEARXNG_BASE_URLS)를 넣거나, 위의 Key 방식 검색 서비스를 쓰세요.
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
# 직접 운영하는 SearXNG 검색 한 번의 제한 시간 (초, 기본 10, 최소 1). 공개 서버에는 적용 안 됨
SEARXNG_TIMEOUT_SECONDS=10

# ===================================
# Social Sentiment Intelligence (US stocks only)
# ===================================
# Reddit / X (Twitter) / Polymarket sentiment data from api.adanos.org
# Only activates for US stock tickers (AAPL, TSLA, etc.), ignored for A-shares/HK stocks
# Free tier: 250 requests/month | Register: https://api.adanos.org
# SOCIAL_SENTIMENT_API_KEY=sk_live_your_key_here
# SOCIAL_SENTIMENT_API_URL=https://api.adanos.org

# ===================================
# 뉴스 기간과 분석 필터 설정
# ===================================
# 뉴스 기간 단계: ultra_short(1일) / short(3일) / medium(7일) / long(30일)
# 실제 기간 = min(단계 기간, NEWS_MAX_AGE_DAYS)
# NEWS_STRATEGY_PROFILE=short
# 뉴스 최대 기간(일). 오래된 정보를 쓰지 않도록 최근 기사만 검색합니다
# NEWS_MAX_AGE_DAYS=3
# 내 컴퓨터에 모아 둔 뉴스(정보 풀) 보관 일수. 정보 풀 intelligence_items 만 지우고 지난 보고서는 그대로 둡니다
# NEWS_INTEL_RETENTION_DAYS=30
# RSS/Atom 뉴스 출처 하나를 받아오는 제한 시간(초)
# NEWS_INTEL_FETCH_TIMEOUT_SEC=8
# 한 번에 뉴스 출처 하나당 가져오는 최대 개수
# NEWS_INTEL_MAX_ITEMS_PER_SOURCE=50
# 켜면 종목 분석, Agent 분석, 시장 리뷰가 정보 풀을 읽기 전에 내장 뉴스 출처를 준비하고 켜진 출처에서 뉴스를 받아옵니다.
# 확인하지 않은 외부 요청과 분석 입력 변화를 막으려고 기본은 꺼짐
# 참고: 기본 daily_analysis workflow 는 이 값을 넘기지 않으니 Actions 에서 쓰려면 workflow 에도 추가하세요
# NEWS_INTEL_AUTO_FETCH_ENABLED=false
# NewsNow HTTP API 기본 주소 — 외부 서비스 설정
# - 공식 프로젝트와 설치 안내: https://github.com/qqhann/newsnow
# - 현재 기본값 https://newsnow.busiyi.world 는 공개 예시 서버라서 다음 위험이 있어요:
#   * 관리 작업이나 요청 제한으로 쓸 수 없을 때가 있음
#   * 안정성과 데이터 신뢰성을 보장하지 않음, 시연·테스트용
# - 실제 운영에서는 직접 운영하는 NewsNow 서버로 바꾸는 것을 강하게 권합니다
# - 설치 전에 API 형식이 맞는지 확인하세요 (docs/intelligence-sources.md 참고):
#   curl -sS "https://newsnow.busiyi.world/api/s?id=cls-hot" | python -c "import sys, json; data=json.load(sys.stdin); assert isinstance(data.get('items'), list)"
# - 이 설정은 뉴스 수집과 정리에만 영향을 주고 LLM / provider / base URL / 호환 예비 동작은 바꾸지 않습니다
# NEWSNOW_BASE_URL=https://newsnow.busiyi.world
# 이격도 기준(%). MA5 에서 이 값보다 멀어지면 "추격 매수 주의"를 띄우고, 강한 추세 종목은 1.5배까지 자동으로 완화
# BIAS_THRESHOLD=5.0

# ===================================
# Agent 전략 대화 설정 (Web 대화 화면)
# ===================================
# Agent 전략 대화 켜기 (기본 false, 내부에서는 skill 이라고 부름)
# AGENT_MODE=true
# 종목 질문에 쓸 주 모델 (선택). 비우면 주 모델을 그대로 쓰고, provider 접두어가 없으면 openai/<model> 로 해석합니다. Codex 는 이 값을 쓰지 않음
# AGENT_LITELLM_MODEL=
# Agent 자원 한도: 기본 모델에서는 추론 단계 수 상한 (기본 10 이면 각 하위 Agent 가 자기 설정대로 동작), Codex 에서는 질문 한 번당 도구 호출 횟수 상한
# AGENT_MAX_STEPS=10
# 기본으로 켤 전략 (쉼표로 구분). 설정하지 않으면 아래 내장 기본값 사용
#
# 내장 전략 목록 (자유롭게 조합 가능):
#   bull_trend          — 상승 추세 (MA5>MA10>MA20 정배열 + 낮은 이격도)
#   ma_golden_cross     — 골든크로스 (MA5 가 MA10/MA20 을 위로 돌파)
#   volume_breakout     — 거래량 동반 돌파 (가격이 최근 고점을 넘고 거래량 증가)
#   hot_theme           — 인기 테마 (정책·산업 이슈, 업종 확산과 종목 연관성)
#   event_driven        — 이벤트 기반 (실적, 정책, 수주, 인수합병 같은 계기)
#   growth_quality      — 성장의 질 (매출·이익, ROE, 현금흐름, 성장 지속성)
#   expectation_repricing — 기대치 재평가 (실적·정책·밸류에이션 기대와의 차이가 메워지거나 빗나감)
#   shrink_pullback     — 거래량 감소 눌림목 (이동평균선까지 내려오고 거래량 감소, 저점 매수 지점)
#   bottom_volume       — 바닥권 거래량 증가 (바닥에서 거래량이 늘며 반등하는 신호)
#   dragon_head         — 대장주 전략 (강한 대장주, 추세가 이어질 때 따라 사기)
#   one_yang_three_yin  — 양봉 사이 음봉 세 개 (세력의 물량 털기 뒤 강하게 되돌리는 모양)
#   box_oscillation     — 박스권 등락 (구간 안에서 고점 매도·저점 매수)
#   chan_theory          — 찬 이론 (Chan theory: 필/선분/중추 구간)
#   wave_theory         — 파동 이론 (엘리엇 파동 세기)
#   emotion_cycle       — 심리 주기 (시장 심리의 고점·저점 순환)
#
# 비워 두면 metadata 에 적힌 기본 전략 skill 을 씁니다 (내장 기본은 bull_trend)
# AGENT_SKILLS=
#
# 직접 전략 묶음을 지정할 수도 있어요:
# AGENT_SKILLS=bull_trend,ma_golden_cross,shrink_pullback
#
# 내장 전략 전부 켜기 (두 방법 모두 같음):
# AGENT_SKILLS=all
# AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,hot_theme,event_driven,growth_quality,expectation_repricing,shrink_pullback,bottom_volume,dragon_head,one_yang_three_yin,box_oscillation,chan_theory,wave_theory,emotion_cycle
#
AGENT_SKILLS=
# 직접 만든 전략 폴더 (선택, 직접 만든 YAML 전략 파일을 두는 곳. 변수 이름은 내부 skill 이름을 그대로 씀)
# AGENT_SKILL_DIR=./strategies

# Agent 구조 (기본 single, multi 는 여러 Agent 를 함께 쓰는 방식)
# AGENT_ARCH=single

# Multi-Agent 진행 방식 (AGENT_ARCH=multi 일 때만)
# quick: 기술적 분석→결정 (가장 빠름, LLM 호출 약 2회)
# standard: 기술→정보→결정 (기본)
# full: 기술→정보→위험 관리→결정
# specialist: 기술→정보→위험 관리→전략 전문가 평가→결정
# AGENT_ORCHESTRATOR_MODE=standard

# Agent 실행 제한 시간 (초. 기본 LiteLLM 경로는 0 으로 끌 수 있고, Codex 는 질문마다 반드시 끝나도록 0 보다 커야 함. 기본 600)
# AGENT_ORCHESTRATOR_TIMEOUT_S=600

# 하위 Agent 별 제한 시간 (초, 0=끔. 180 같은 양수로 두면 그 Agent 에 별도 상한이 생김)
# 적용 규칙:
#   - 전체 Pipeline 예산이 꺼져 있으면(AGENT_ORCHESTRATOR_TIMEOUT_S=0): 하위 Agent 상한이 그 Agent 의 절대 제한 시간
#   - 전체 Pipeline 예산이 켜져 있으면: 실제 상한 = min(남은 Pipeline 예산, 하위 Agent 상한), 둘 중 작은 값
#   - 설정하지 않으면(기본 0): 별도 상한 없이 남은 Pipeline 예산만 적용
# AGENT_TECHNICAL_AGENT_TIMEOUT_S=0
# AGENT_INTEL_AGENT_TIMEOUT_S=0
# AGENT_RISK_AGENT_TIMEOUT_S=0
# AGENT_DECISION_AGENT_TIMEOUT_S=0
# AGENT_PORTFOLIO_AGENT_TIMEOUT_S=0
# AGENT_SKILL_AGENT_TIMEOUT_S=0

# Agent 도구 종류별 기본 제한 시간 (초, 0=끔. 설정하지 않으면 전체 tool_call_timeout_seconds 예산 사용)
# 실제 제한 시간은 앞쪽이 우선: 실행별 tool_call_timeout_seconds > 도구별 timeout_seconds > 종류별 기본값 > 제한 없음.
# 남은 전체 시간 예산은 넘을 수 없는 바깥 상한으로만 쓰이고, inf/nan/음수는 제한 없음으로 봅니다.
# market 종류 도구(get_market_indices / get_sector_rankings 등 네트워크 데이터 호출)는 AGENT_DATA_TOOL_TIMEOUT_S 를 같이 쓰고 별도 스위치는 없습니다.
# AGENT_DATA_TOOL_TIMEOUT_S=0
# AGENT_SEARCH_TOOL_TIMEOUT_S=0
# AGENT_ANALYSIS_TOOL_TIMEOUT_S=0
# AGENT_ACTION_TOOL_TIMEOUT_S=0

# 전략 전문가 동시 실행 수 (specialist 모드에서만, 1-4, 기본 3)
# AGENT_SKILL_CONCURRENCY=3

# 위험 관리 Agent 가 매수 신호를 거부할 수 있는지 (기본 켜짐)
# AGENT_RISK_OVERRIDE=true

# 기억·보정 기능 (지난 적중률을 추적해 확신도를 자동 조절)
# AGENT_MEMORY_ENABLED=false

# 표본이 충분한 실제 Skill 결과를 바탕으로 전략 의견에 보수적으로 가중치를 줌
# AGENT_SKILL_AUTOWEIGHT=true

# 전략 선택 방식 (auto=시장 상황에 따라 자동 선택 / manual=AGENT_SKILLS 목록 사용)
# AGENT_SKILL_ROUTING=auto

# 종목 질문 대화 기록 압축 (기본 꺼짐). 켜면 사용자에게 보이는 user/assistant 기록만 줄이고, 같은 턴의 tool/thinking 전달에는 영향 없음.
# AGENT_CONTEXT_COMPRESSION_ENABLED=false
# 압축 방식: cost=token 절약 / balanced=균형 / long_context_raw_first=원문을 더 많이 남김
# AGENT_CONTEXT_COMPRESSION_PROFILE=balanced
# 압축을 시작하는 기록 token 기준. 비우면 현재 profile 기본값을 따름
# AGENT_CONTEXT_COMPRESSION_TRIGGER_TOKENS=
# 압축할 때 최근 N 번의 사용자 질문과 그 뒤 답변은 원문 그대로 둠. 비우면 현재 profile 기본값을 따름
# AGENT_CONTEXT_PROTECTED_TURNS=

# 이벤트 알림 감시 (schedule 모드에서 주기적으로 확인하고, 조건이 맞으면 설정된 알림 채널로 보냄)
# 호환성 안내: 이 부분은 알림 규칙만 추가하고 모델 이름, provider, Base URL, LiteLLM, LLM 설정 의미는 바꾸지 않습니다. 되돌리려면 이벤트 감시 설정만 끄거나 지우면 됩니다.
# legacy JSON 은 종목 하나에 대한 기본 규칙 세 가지만 지원해요. 기술 지표, 관심종목, 보유 종목/계좌, 시장 신호등 규칙은 Web/API 알림 센터에서 설정하세요.
# legacy JSON 이 지원하는 규칙:
#   price_cross          — 가격이 기준을 넘음, direction: above / below, 항목: price
#   price_change_percent — 등락률 기준, direction: up / down, 항목: change_pct (단위: %)
#   volume_spike         — 거래량 급증, 항목: multiplier (최근 20일 평균 거래량 대비 배수)
# AGENT_EVENT_MONITOR_ENABLED=false
# AGENT_EVENT_MONITOR_INTERVAL_MINUTES=5
# AGENT_EVENT_ALERT_RULES_JSON=[{"stock_code":"600519","alert_type":"price_cross","direction":"above","price":1800},{"stock_code":"300750","alert_type":"price_change_percent","direction":"down","change_pct":3.0},{"stock_code":"000858","alert_type":"volume_spike","multiplier":2.5}]
# ====== 딩톡 봇 (DingTalk, 중국 메신저) ======
# 딩톡 그룹 봇의 Webhook URL
DINGTALK_WEBHOOK_URL=
# 딩톡 봇 서명 비밀값 (SEC 로 시작하는 문자열). 서명을 켜지 않았다면 비워 둬도 됨
DINGTALK_SECRET=
# ===================================
# 알림 채널 설정 (여러 개를 함께 설정하면 모두에게 보냄)
# ===================================
#
# [방법 1] 기업용 위챗(WeCom) 봇
# 기업용 위챗 그룹 -> 설정 -> 그룹 봇 -> 추가 -> Webhook 주소 복사
#
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
#
# [방법 2] 페이슈(Feishu) 봇 (둘 중 하나)
#
# 방법 2a — 그룹 사용자 지정 봇 Webhook
# 페이슈 그룹 -> 설정 -> 그룹 봇 -> 봇 추가 -> 사용자 지정 봇 -> Webhook 주소 복사
#
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_key_here
# 봇 보안 설정에서 "서명 확인"을 켰다면 secret 도 넣어야 함
# FEISHU_WEBHOOK_SECRET=your_feishu_webhook_secret
# 봇 보안 설정에서 "키워드"를 켰다면 같은 키워드를 넣으세요. 메시지마다 앞에 자동으로 붙여 줍니다
# FEISHU_WEBHOOK_KEYWORD=주식리포트
#
# 방법 2b — 페이슈 앱 봇(App Bot)으로 보내기
# 페이슈 오픈 플랫폼에서 앱을 만들고 im:message 권한을 켠 뒤 배포하세요.
#
# 그룹 채팅 방식 (권장): 봇을 대상 그룹에 초대하고 그룹 설정에서 chat_id 확인
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
#
# 개인 메시지 방식: 지정한 사용자에게 바로 보냄. 사용자의 open_id 는 봇 이벤트나 연락처 API 로 확인.
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=ou_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=open_id
# FEISHU_DOMAIN=feishu  # 도메인: feishu(중국 내) / lark(해외판 larksuite.com)
#
# [방법 3] 텔레그램 봇 (두 항목 모두 필요)
# 1. 텔레그램에서 @BotFather 검색 -> /newbot -> Bot Token 받기
# 2. Chat ID 확인: @userinfobot 에게 메시지를 보내거나 https://api.telegram.org/bot<token>/getUpdates 접속
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# [방법 4] 이메일로 보내기 (2개 항목만 넣으면 SMTP 자동 인식)
# QQ 메일, 163 메일, Gmail 등 SMTP 앱 비밀번호/기본 인증을 지원하는 메일
# Outlook / Exchange 가 OAuth2 를 강제하는 경우는 아직 지원하지 않음
# 1. 인증 코드 받기 (QQ 메일 예: 설정 -> 계정 -> POP3/SMTP 서비스 -> 켜기 -> 인증 코드 받기. Gmail 은 Google 계정의 앱 비밀번호)
# 2. 아래 두 항목만 채우면 됩니다:
#
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=receiver@example.com  # 선택, 비워 두면 나에게 보냄
#
# [방법 4 확장] 종목 묶음별로 다른 메일로 보내기 (Issue #268, 선택)
# 실제 분석 대상은 STOCK_LIST 가 정하고, STOCK_GROUP_N 은 메일 받는 사람만 정합니다. 항상 STOCK_LIST 안의 종목으로 적으세요
# 텔레그램 / 기업용 위챗 / Webhook 등 다른 채널은 묶음과 상관없이 STOCK_LIST 전체를 보냅니다
# 기본 GitHub Actions daily_analysis workflow 는 번호가 붙은 STOCK_GROUP_N / EMAIL_GROUP_N 을 넘기지 않아요
# 그래서 이 기능은 내 .env, Docker, 또는 이 값들을 직접 넣어 주는 환경에서만 됩니다
# STOCK_GROUP_1=600519,300750
# EMAIL_GROUP_1=user1@example.com
# STOCK_GROUP_2=002594,AAPL
# EMAIL_GROUP_2=user2@example.com
#
# [방법 5] 사용자 지정 Webhook (여러 개는 쉼표로 구분)
# 딩톡, 디스코드, 슬랙, Bark, 직접 만든 서비스 등 POST JSON 을 받는 Webhook 이면 됩니다
# 자주 쓰는 서비스는 자동으로 알아보고 맞는 형식으로 보냅니다
#
# CUSTOM_WEBHOOK_URLS=https://oapi.dingtalk.com/robot/send?access_token=xxx,https://hooks.slack.com/services/xxx
# CUSTOM_WEBHOOK_BEARER_TOKEN=  # 선택, 인증이 필요한 Webhook 용 (Header Authorization: Bearer <token>)
# CUSTOM_WEBHOOK_BODY_TEMPLATE=  # 선택, 전체 JSON body 견본. Bark/Slack/Discord 등의 자동 payload 를 덮어씀. $content_json/$title_json 권장
# Docker Compose 용 .env 를 직접 쓸 때는 $$content_json/$$title_json 처럼 쓰세요. Web 설정 화면은 자동으로 바꿔 주고, 실행할 때 다시 $ 하나로 돌아갑니다
# WEBHOOK_VERIFY_SSL=true   # 기본은 인증서 확인. 이 값을 읽는 webhook 방식 HTTPS 알림에 적용. false 로 두면 자체 서명 인증서도 허용하지만 중간자 공격(MITM) 위험이 있어 믿을 수 있는 내부망에서만 쓰세요
#
# [방법 6] Pushover 설정
# Pushover 계정을 만들고 앱 Token 발급: https://pushover.net/apps/build
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
#
# [방법 6 확장] ntfy 설정
# NTFY_URL 에는 topic 경로가 꼭 들어가야 해요. 예: https://ntfy.sh/my-topic 또는 https://self-hosted:port/my-topic
# topic 을 읽어 ntfy JSON publish API 로 Markdown 글을 보냅니다.
# NTFY_URL=
# NTFY_TOKEN=  # 선택, Bearer Token 이 필요한 topic 이나 직접 운영하는 ntfy 서버용
#
# [방법 6 확장] Gotify 설정
# GOTIFY_URL 은 /message 를 뺀 Gotify 서버 기본 주소예요. /message 를 붙이고 X-Gotify-Key Header 로 token 을 보냅니다.
# GOTIFY_URL=
# GOTIFY_TOKEN=  # Gotify application token
#
# [방법 7] PushPlus 설정 (중국 내 알림 서비스)
# PushPlus 계정을 만들고 Token 발급: https://www.pushplus.plus
# PUSHPLUS_TOKEN=
# 그룹 알림: 그룹 코드를 넣으면 그룹 구독자 모두에게 보냄 (1대다)
# PUSHPLUS_TOPIC=
#
# [방법 8] 디스코드 설정
# 두 가지 방식: Webhook (권장, 설정이 간단) 과 Bot API (권한이 많음)
# 
# 방식 1: 디스코드 Webhook (권장, 봇 계정 필요 없음)
# 디스코드 서버 설정 -> 연동 -> 웹후크 -> 새 웹후크 -> 웹후크 URL 복사
# 이 한국어판에서 쓰는 방식이에요. 아래 줄 맨 앞의 # 을 지우고 복사한 주소를 붙여 넣으세요.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# 
# 방식 2: 디스코드 Bot API (봇 계정과 채널 ID 필요)
# 1. 봇 만들기: https://discord.com/developers/applications -> New Application -> Bot -> 봇 생성
# 2. Bot Token 받기: Bot 페이지 -> Reset Token
# 3. 채널 ID 확인: 디스코드 개발자 모드 켜기 -> 채널 오른쪽 클릭 -> ID 복사
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=
# DISCORD_CHANNEL_ID=   # 예전 변수 이름 호환용, DISCORD_MAIN_CHANNEL_ID 사용 권장
# DISCORD_MAX_WORDS=2000 # 디스코드 메시지 한 개는 2000자까지. 긴 보고서는 2000자 이하로 나눠서 보냄
# 디스코드 Interaction / Webhook 콜백을 받으려면 서명 확인용 공개 키를 꼭 넣어야 함
# 확인 위치: Discord Developer Portal -> General Information -> Public Key
# DISCORD_INTERACTIONS_PUBLIC_KEY=
# 
# [방법 9] 슬랙 설정
# 두 가지 방식: Bot API (권장) 와 Incoming Webhook
# 둘 다 설정하면 Bot API 를 먼저 써서 글과 이미지가 같은 채널로 가게 합니다.
#
# 방식 1: 슬랙 Bot API (권장, 이미지 업로드 지원)
# 1. Slack App 만들기: https://api.slack.com/apps -> Create New App
# 2. Bot Token Scopes 추가: chat:write, files:write
# 3. 워크스페이스에 설치하고 Bot Token (xoxb-...) 받기
# 4. 채널 ID 확인: 채널 정보 -> 맨 아래에서 채널 ID 복사
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C01234567
#
# 방식 2: 슬랙 Incoming Webhook (설정이 간단, 이미지 업로드는 안 됨)
# Slack App 관리 화면에서 Incoming Webhook 만들기 -> URL 복사
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
#
# [방법 10] ServerChan3 설정 (중국 내 알림 서비스, 위챗 알림 지원)
# ServerChan3 계정을 만들고 SendKey 발급: https://sc3.ft07.com/
# SERVERCHAN3_SENDKEY=
#
# [방법 11] AstrBot 설정
# ASTRBOT_URL=
# ASTRBOT_TOKEN=  # 선택, Bearer Token 이 필요한 AstrBot Webhook 용
#
# [고급 설정] 메시지 길이 제한 (바이트)
# 제한을 넘으면 나눠서 보내므로 보통은 바꿀 필요 없음
# FEISHU_MAX_BYTES=20000    # 페이슈 제한 약 20KB, 기본 20000 바이트
# FEISHU_SEND_AS_FILE=false # true 면 페이슈에 보고서를 파일로 보냄 (App Bot 방식), 기본은 글 메시지
# WECHAT_MAX_BYTES=4000     # 기업용 위챗 제한 4096 바이트, 기본 4000 바이트
#
# [Markdown 을 이미지로 바꾸기] (Issue #455)
# Markdown 을 지원하지 않는 채널에는 보고서를 이미지로 바꿔 보내 읽기 쉽게 합니다
# 종목별 알림 + 이미지: MARKDOWN_TO_IMAGE_CHANNELS 설정과 이미지 변환 도구 설치가 모두 필요
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,wechat,custom,email,slack   # 쉼표로 구분
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000   # 이 길이를 넘으면 이미지가 너무 커지지 않게 변환하지 않음
# MD2IMG_ENGINE=wkhtmltoimage   # wkhtmltoimage(기본) | markdown-to-file | playwright (Web 의존성과 npx playwright install chromium 필요)
# 공유 이미지에는 기본으로 원작자의 샤오훙슈 QR 코드와 닉네임이 들어가요. 아래 설정으로 이 정보를 통째로 바꿀 수 있습니다
# SHARE_IMAGE_XIAOHONGSHU_URL=
# SHARE_IMAGE_XIAOHONGSHU_HANDLE=@霸天土小豆  # 모두 비워 두면 내장 닉네임 표시
# SHARE_IMAGE_XIAOHONGSHU_QR_PATH=assets/my-xiaohongshu-qr.png  # 모두 비워 두면 내장 QR 코드 사용
# 변환 도구: wkhtmltopdf (apt install wkhtmltopdf / brew install wkhtmltopdf) 또는 markdown-to-file
#
# [알림 채널 고르기] (Issue #1200 P3)
# 기본은 비워 둠: 해당 종류의 알림을 설정된 모든 채널로 보냅니다. 적으면 적은 채널로만 보냅니다.
# 쓸 수 있는 값: wechat,dingtalk,feishu,telegram,email,pushover,ntfy,gotify,pushplus,serverchan3,custom,discord,slack,astrbot
# NOTIFICATION_REPORT_CHANNELS=
# NOTIFICATION_ALERT_CHANNELS=
# NOTIFICATION_SYSTEM_ERROR_CHANNELS=
#
# [알림 줄이기] (Issue #1200 P4)
# 기본은 모두 꺼짐. 고정 알림 채널에만 적용되고, 봇 대화 응답에는 영향 없음.
# NOTIFICATION_DEDUP_TTL_SECONDS=0      # 같은 알림은 이 시간(초) 안에 한 번만 보냄. 0 이면 끔
# NOTIFICATION_COOLDOWN_SECONDS=0       # 같은 종류 알림 사이 최소 간격(초). 0 이면 끔
# NOTIFICATION_QUIET_HOURS=             # 알림을 끄는 시간대, HH:MM-HH:MM 형식, 자정을 넘겨도 됨
# NOTIFICATION_TIMEZONE=                # 알림을 끄는 시간대의 기준 시간대, 예: Asia/Seoul. 비우면 TZ/컴퓨터 시간대를 따름
# NOTIFICATION_MIN_SEVERITY=            # info,warning,error,critical 중 하나. 비우면 지금처럼
# NOTIFICATION_DAILY_DIGEST_ENABLED=false  # 나중을 위해 남겨 둔 설정. 지금은 일일 요약을 보내지 않음
#
# [실시간 시세 미리 받기] (Issue #455)
# PREFETCH_REALTIME_QUOTES=true   # false 로 두면 끔 (efinance/akshare_em 의 전체 시장 받기를 피함). tushare 는 종목별 방식이라 첫 종목만 미리 받음

# ===================================
# 종목별 알림 설정 (선택)
# ===================================
# 종목별 알림: 모아서 한 번에 보내지 않고 종목 하나 분석이 끝날 때마다 바로 보냄
# SINGLE_STOCK_NOTIFY=false
#
# 보고서 종류: simple(간단), full(전체), brief(3-5문장 요약)
# Docker 에서 알림 내용이 잘리면 full 로 바꿔 보세요
# REPORT_TYPE=simple
# 보고서 언어: ko(한국어, 한국어판 기본값) / zh(중국어, 원래 프로젝트 기본값) / en(영어)
REPORT_LANGUAGE=ko
# 요약만 보내기: true 면 종목별 상세 없이 요약만 보냄
# REPORT_SUMMARY_ONLY=false
# 보고서 맨 아래에 이번에 쓴 LLM 모델 이름 표시. false 면 숨김
# REPORT_SHOW_LLM_MODEL=true
#
# Report Engine P0 (Jinja2 / 빠진 내용 확인 / 지난 보고서와 비교)
# REPORT_TEMPLATES_DIR=templates
# REPORT_RENDERER_ENABLED=false
# REPORT_INTEGRITY_ENABLED=true
# REPORT_INTEGRITY_RETRY=1
# REPORT_HISTORY_COMPARE_N=0

# 종목 분석과 시장 리뷰를 한 번에 보내기 (기본 false). 메일 수를 줄여 스팸 처리될 위험을 낮춤
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# 분석 간격 설정 (선택)
# ===================================
# 종목 분석과 시장 분석 사이 대기 시간 (초)
# Gemini 같은 AI API 의 요청 제한에 걸리지 않게 할 때 사용
# ANALYSIS_DELAY=0

# 딩톡 앱 AppKey (Webhook 방식과 같이 씀)
DINGTALK_APP_KEY=xxxx
# 딩톡 앱 AppSecret (Webhook 방식과 같이 씀)
DINGTALK_APP_SECRET=xxxx
# 딩톡 Stream 방식 켜기
DINGTALK_STREAM_ENABLED=false

# 페이슈 앱 설정 (App Bot 알림 / Stream Bot / 클라우드 문서용. 그룹 Webhook 알림을 켜지는 않음)
FEISHU_APP_ID=xxxx
FEISHU_APP_SECRET=xxxx  # App Bot 알림에는 FEISHU_CHAT_ID 도 필요. 간단한 그룹 알림은 FEISHU_WEBHOOK_URL 을 쓰세요
# App Bot 알림 대상. Stream Bot 이나 클라우드 문서에는 필요 없음
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
# 장기 연결(Stream) 방식 켜기
FEISHU_STREAM_ENABLED=false
# 페이슈 그룹 봇 Webhook 보안 설정 (Webhook 알림에서만 사용)
# FEISHU_WEBHOOK_SECRET=your_feishu_webhook_secret
# FEISHU_WEBHOOK_KEYWORD=주식리포트

# 데이터베이스 경로
DATABASE_PATH=./data/stock_analysis.db
# SQLite 쓰기 최적화: 파일 DB 는 기본으로 WAL 을 켜서 한꺼번에·동시에 쓸 때 잠금 충돌을 줄임
SQLITE_WAL_ENABLED=true
# SQLite 잠금 대기 제한 시간 (밀리초)
SQLITE_BUSY_TIMEOUT_MS=5000
# SQLite 에서 database is locked / database table is locked 가 날 때 최대 재시도 횟수
SQLITE_WRITE_RETRY_MAX=3
# SQLite 쓰기 재시도 기본 대기 시간 (초, 재시도할수록 점점 길어짐)
SQLITE_WRITE_RETRY_BASE_DELAY=0.1

# 분석 기록 스냅샷: false 면 context_snapshot 전체를 저장하지 않음
# (enhanced_context, market_phase_summary, AnalysisContextPack overview, diagnostics, raw snapshot 항목 포함)
SAVE_CONTEXT_SNAPSHOT=true

# ===================================
# 백테스트 설정 (선택)
# ===================================
# 백테스트 켜기 (true/false)
BACKTEST_ENABLED=true
# 백테스트 평가 기간 (거래일 수)
BACKTEST_EVAL_WINDOW_DAYS=10
# N일 이전 분석 기록만 백테스트 (당일·최근 데이터는 덜 모였을 수 있어서)
BACKTEST_MIN_AGE_DAYS=14
# 백테스트 엔진 버전 (계산 방식이 바뀌었을 때 결과를 구분하는 용도)
BACKTEST_ENGINE_VERSION=v1
# 보합 구간 기준(%). 예: 2 면 -2%~+2% 를 횡보로 봄
BACKTEST_NEUTRAL_BAND_PCT=2.0

# ===================================
# ETF 순환 투자 설정 (선택, python main.py --etf-rotation 에서만 사용)
# 규칙 설명은 docs/etf-rotation.md (중국어). 아래는 모두 기본값
# ===================================
# 위험 자산 후보 (쉼표로 구분): CSI300 / CSI500 / 차이넥스트 / 고배당 저변동 / 나스닥 / 금 (모두 중국 상장 ETF)
# ETF_ROTATION_POOL=510300,510500,159915,512890,513100,518880
# 방어 자산 (머니마켓 ETF). 비우면 현금 보유
# ETF_ROTATION_SAFE_ASSET=511880
# 모멘텀 계산 기간 (거래일)
# ETF_ROTATION_LOOKBACK_DAYS=60
# 리밸런싱 주기: weekly / monthly
# ETF_ROTATION_REBALANCE=weekly
# 동시에 최대 몇 개까지 보유할지
# ETF_ROTATION_TOP_N=2
# 교체 여유폭 (%p). 보유 중인 종목이 이만큼 이내로만 뒤처지면 계속 보유
# ETF_ROTATION_SWITCH_BUFFER_PCT=2.0
# 한 번 거래할 때 비용 (bp)
# ETF_ROTATION_COST_BPS=10
# 백테스트 기간 (년)
# ETF_ROTATION_BACKTEST_YEARS=8

# === 정해진 시간 실행 설정 ===
# 예약 실행 방법은 하나만 쓰는 걸 권해요. 같은 DATABASE_PATH 를 쓰는 CLI/Web 매일 작업은 예약 시각 기준으로 중복 실행을 막습니다
# 시작할 때 바로 실행과 수동 재실행은 중복을 막지 않고, 시작 후 실패하면 직접 다시 실행해야 합니다. 자세한 내용은 docs/DEPLOY.md (중국어)
# 정해진 시간 실행 켜기 (true/false)
SCHEDULE_ENABLED=false
# 매일 실행 시각 (HH:MM, 24시간제)
SCHEDULE_TIME=08:00
# 여러 시각에 실행 (쉼표로 구분, 비우면 SCHEDULE_TIME 사용)
SCHEDULE_TIMES=
# Web/API 예약 실행에서 분석 한 번의 강제 제한 시간 (초, 최소 60)
DSA_RUNTIME_SCHEDULER_TIMEOUT_SECONDS=2700
# 제한 시간에 걸렸을 때 이미 저장된 종목만이라도 알림을 보낼지 (true/false. 기본 true, 설정하지 않아도 켜짐. 예전에는 시간 초과 시 보내지 않았음)
DSA_TIMEOUT_PARTIAL_NOTIFY=true
# 예약 모드로 시작할 때 바로 한 번 분석할지 (true/false)
# 직접 정하지 않으면 예전 설정과 맞추기 위해 RUN_IMMEDIATELY 값을 따릅니다
SCHEDULE_RUN_IMMEDIATELY=true
# 예약 모드 시작 시 바로 실행할 때 같은 날 중복 실행 막기 (true/false, 기본 true)
# 시작 시 실행 전에 표시 파일(DATABASE_PATH 가 있는 폴더, 기본 data/analysis_run_state.json)을 확인해서,
# 오늘 이미 지금 분석할 목록을 모두 포함한 전체 분석이 성공했으면(날짜 + scope=full + 목록 포함 여부) 건너뛰고,
# 아니면 평소처럼 실행합니다. 매일 예약 실행과 수동/API 실행은 절대 건너뛰지 않습니다.
# 표시 파일이 없거나 깨졌거나 형식을 모르거나 목록이 덜 포함되면 무조건 실행합니다(빠뜨리지 않음). 시장 리뷰 완료 여부는 기록만 하고 판단에는 쓰지 않습니다.
SCHEDULE_STARTUP_DEDUP=true
# 예약 모드가 아닐 때 시작하자마자 한 번 분석할지 (true/false)
RUN_IMMEDIATELY=true
# 시장 전체 리뷰 켜기 (true/false)
MARKET_REVIEW_ENABLED=true
# 시장 분위기 요약을 종목 분석 Prompt 에 넣고 보수적인 안전장치를 켤지 (true/false, 기본 켜짐)
DAILY_MARKET_CONTEXT_ENABLED=true
# 시장 리뷰 대상: cn(중국 A주), hk(홍콩), us(미국), jp(일본), kr(한국), both(전체 시장)
# 쉼표로 여러 개 지정 가능 (예: cn,us,kr). 잘못된 값이나 빈 값은 cn 으로 처리됩니다. 한국 시장만 보려면 kr 로 두세요.
# MARKET_REVIEW_REGION=kr
# 시장 리뷰 지수 등락 색: green_up=초록 상승·빨강 하락(기본), red_up=빨강 상승·초록 하락(한국식)
# MARKET_REVIEW_COLOR_SCHEME=green_up

# ===================================
# 프록시 설정 (선택)
# ===================================
# 프록시 사용 (true/false, 기본 false)
# 내 컴퓨터에서만 적용되고 GitHub Actions 에서는 자동으로 건너뜀
USE_PROXY=false
# 프록시 서버 주소 (기본 127.0.0.1)
PROXY_HOST=127.0.0.1
# 프록시 서버 포트 (기본 10809)
PROXY_PORT=10809

# 시스템 설정
# 실행 기록(로그) 폴더
LOG_DIR=./logs
# 로그 수준 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# LiteLLM 내부 로그 수준 (DEBUG/INFO/WARNING/ERROR/CRITICAL, 기본 WARNING. 내부 스트리밍·연결 문제를 볼 때 잠깐 DEBUG 로)
# LITELLM_LOG_LEVEL=WARNING
# 동시에 처리할 최대 작업 수 (차단당하지 않게 낮게 두는 것을 권장)
MAX_WORKERS=3
# 디버그 로그 켜기
DEBUG=false

# ===================================
# WebUI 설정 (선택)
# ===================================
# 기본으로 WebUI 시작 (true/false, 기본 false)
WEBUI_ENABLED=false
# WebUI 주소 (기본 127.0.0.1. Docker/클라우드 서버에서 밖에서 접속하려면 0.0.0.0, 자세한 내용은 docs/deploy-webui-cloud.md)
WEBUI_HOST=127.0.0.1
# WebUI 포트 (기본 8000)
WEBUI_PORT=8000
# Web 서비스 시작 전에 화면 코드를 자동으로 빌드할지 (npm install && npm run build, 기본 true)
WEBUI_AUTO_BUILD=true
# 믿을 수 있는 리버스 프록시 한 단계(예: Nginx → App) 뒤에 있을 때 X-Forwarded-For 의 맨 오른쪽 값을 실제 IP 로 보고 로그인 제한에 씁니다. 프록시/CDN 이 여러 단계면 제한 기준이 바깥 프록시 IP 가 될 수 있어 따로 따져 봐야 하고, 인터넷에 바로 열려 있으면 위조를 막기 위해 false 로 두세요
# TRUST_X_FORWARDED_FOR=false

# ===================================
# Web 로그인 (선택)
# ===================================
# true 면 비밀번호 보호를 켭니다. 처음 접속할 때 웹에서 비밀번호를 정하고, 나중에 시스템 설정의 비밀번호 변경에서 바꿀 수 있어요
# 비밀번호를 잊으면 서버에서 실행: python -m src.auth reset_password
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24  # 로그인 유지 시간 (시간)

# ===================================
# 보안 미들웨어 fastapi-guard (선택, 기본 꺼짐, 바꾸면 서비스 재시작 필요)
# ===================================
# true 면 API/WebUI 에 IP 별 요청 제한, IP 허용/차단 목록, 수상한 요청 차단, 스캐너 자동 차단을 더합니다. 위의 로그인 실패 제한을 대신하지 않고 함께 동작해요
# Set to true to add per-IP rate limiting, an IP allow/block list, request screening and automatic scanner bans.
# It complements (does not replace) the login failure limiter above. State is in memory, per process; no Redis needed.
# GUARD_ENABLED=false
# IP 하나가 정해진 시간 안에 보낼 수 있는 최대 요청 수 (정적 파일과 상태 확인 포함) / Max requests per IP per window (static assets and health checks count)
# GUARD_RATE_LIMIT=300
# GUARD_RATE_LIMIT_WINDOW=60
# IP 허용 목록 (쉼표로 구분, CIDR 가능). 값이 있으면 목록 안의 IP 만 허용하고 나머지는 403 / Allowlist (comma separated, CIDR ok); when set, every other IP gets 403 and listed IPs are exempt from the rate limit
# GUARD_WHITELIST=
# IP 차단 목록 (쉼표로 구분, CIDR 가능) / Blocklist (comma separated, CIDR ok)
# GUARD_BLACKLIST=
# TRUST_X_FORWARDED_FOR=true 일 때만 적용: X-Forwarded-For 를 믿어도 되는 프록시 주소 (기본은 이 컴퓨터 루프백만). 이 주소에서 온 연결만 X-Forwarded-For 의 맨 오른쪽 값을 쓰고, 다른 곳에서 온 이 헤더는 무시합니다(로그인 제한도 맨 오른쪽 값을 쓰지만 프록시 출처는 확인하지 않음). 켜면 내장 시작 명령이 Uvicorn 도 같은 프록시만 믿게 하고, TRUST_X_FORWARDED_FOR=false 면 Uvicorn 의 프록시 헤더 처리를 끕니다. 리버스 프록시 뒤라면 TRUST_X_FORWARDED_FOR=true 로 두고, uvicorn 을 직접 실행하면 FORWARDED_ALLOW_IPS 를 이 목록과 맞추거나 --no-proxy-headers 를 붙이세요
# Only used when TRUST_X_FORWARDED_FOR=true: proxies allowed to set X-Forwarded-For (default loopback only). Only their rightmost entry is used; the header from any other peer is ignored (the login limiter also takes the rightmost entry but does not check the peer). With the guard on, the built-in entry points make Uvicorn trust the same proxies, or none when TRUST_X_FORWARDED_FOR=false; behind a reverse proxy set TRUST_X_FORWARDED_FOR=true; if you start uvicorn yourself, match FORWARDED_ALLOW_IPS to this list or pass --no-proxy-headers.
# GUARD_TRUSTED_PROXIES=127.0.0.1,::1
# 요청 본문도 검사할지 (기본 false: 경로, 쿼리, 헤더만 검사) / Also scan request bodies (default false: path, query and headers only)
# GUARD_SCAN_BODY=false
# 차단하지 않고 기록만 함, 먼저 지켜본 뒤 켤 때 유용 / Log only, never block; useful for a trial run
# GUARD_PASSIVE_MODE=false

# ===========================================
# 이미지에서 종목 코드 읽기 (설정 화면의 "이미지로 추가")
# ===========================================
# 요청 한 번 제한 시간 60초, 이미지 최대 5MB
# GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY 중 하나 이상 필요 (이미지를 읽을 수 있는 모델)

# ===========================================
# Data Fetcher Priority Configuration
# ===========================================
# Lower number = higher priority (tried first)
# Default priorities: efinance(0) > akshare(1) > tushare/pytdx(2) > baostock(3) > yfinance(4) > tencent(5)
# 위 우선순위는 일반 중국 A주 일봉을 받을 때만 적용됩니다.
# IndexRegistry 에 등록된 중국 지수(현재 sh000016, sh000688, sz399001, sz399006, sh000300)는
# 항상 Tencent > AkShare > TickFlow > YFinance 순서로 시도하고 이 *_PRIORITY 설정은 읽지 않습니다. 설정이 없거나 쓸 수 없는 출처는 건너뜁니다.
# 시장을 명시한 입력(예: sh000016, 000016.SH)만 지수로 처리하고, 000016 만 쓰면 주식으로 처리합니다.
# For US stocks, set YFINANCE_PRIORITY=0 to use Yahoo Finance first

# EFINANCE_PRIORITY=0      # EastMoney (China) - default: 0
# EFINANCE_CALL_TIMEOUT=30 # Timeout (seconds) for efinance API calls; prevents indefinite hangs
#                          # when eastmoney hosts are unreachable. Default: 30
# AKSHARE_PRIORITY=1       # AkShare (China) - default: 1
# TUSHARE_PRIORITY=2       # Tushare Pro (China) - default: 2
# TICKFLOW_PRIORITY=2      # TickFlow (일반 중국 A주 일봉) - 기본: 2. 선택, TICKFLOW_API_KEY 필요
# PYTDX_PRIORITY=2         # Tongdaxin (China) - default: 2
#
# Pytdx custom server (for intranet/deploy): use custom host instead of built-in public servers
# PYTDX_HOST=192.168.1.100
# PYTDX_PORT=7709
# Or multiple servers: PYTDX_SERVERS=ip1:port1,ip2:port2
# BAOSTOCK_PRIORITY=3      # Baostock (China) - default: 3
# YFINANCE_PRIORITY=4      # Yahoo Finance (Global) - default: 4
# TENCENT_PRIORITY=5       # Tencent direct daily K-line - ordinary A-share last-resort
#                          # fallback. Registered indices ignore this value. Default: 5

# Example: Prioritize Yahoo Finance for US stocks
# YFINANCE_PRIORITY=0
# EFINANCE_PRIORITY=99

# ===========================================
# 실시간 시세 출처 우선순위 설정
# ===========================================
# 거래량 비율, 회전율, PER 같은 실시간 데이터를 받을 때 사용 (중국 A주 기준)
# 쓸 수 있는 출처 (쉼표로 구분, 적은 순서대로 시도):
#   - tencent: 텐센트 금융. 거래량 비율/회전율/PE/PB 제공, 종목별 조회가 안정적 (맨 앞 추천)
#   - akshare_sina: 시나 금융. 기본 시세만, 거래량 비율 없음, 매우 안정적
#   - efinance: 동방재부(efinance 라이브러리). 거래량 비율 있음, 전체를 받으면 차단되기 쉬움
#   - akshare_em: 동방재부(akshare 라이브러리). 데이터가 가장 많음, 전체를 받으면 차단되기 쉬움
#   - tickflow: TickFlow. 선택, 우선순위 앞 두 자리에 두면 현재 종목들을 한꺼번에 미리 받음
#   - tushare: Tushare Pro. 2000 포인트 필요, 데이터가 충실함 (유료 사용자 추천)
#
# 기본 우선순위: tencent > akshare_sina > efinance > akshare_em
# Tushare Pro 고포인트 계정이 있으면 tushare 를 맨 앞에 둘 수 있어요:
# REALTIME_SOURCE_PRIORITY=tickflow,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tushare,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# 실시간 시세 사용 (끄면 지난 종가로 분석)
# ENABLE_REALTIME_QUOTE=true

# 장중 실시간 기술 지표: 켜면 실시간 가격으로 이동평균/정배열 계산 (Issue #234), 끄면 전날 종가 사용
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true

# 매물대 분포 사용 (불안정한 API 라서 클라우드에서는 끄는 것을 권장)
# ENABLE_CHIP_DISTRIBUTION=true

# 기업 기본 정보(펀더멘털) 모으기 사용 (P0 기능)
# ENABLE_FUNDAMENTAL_PIPELINE=true

# 펀더멘털 수집 속도·안정성 설정 (단위: 초)
# FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_RETRY_MAX=1
# FUNDAMENTAL_CACHE_TTL_SECONDS=120
# FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===========================================
# Portfolio P0: 가져오기 / 위험 / 환율 대체 설정
# ===========================================
# PORTFOLIO_RISK_CONCENTRATION_ALERT_PCT=35.0
# PORTFOLIO_RISK_DRAWDOWN_ALERT_PCT=15.0
# PORTFOLIO_RISK_STOP_LOSS_ALERT_PCT=10.0
# PORTFOLIO_RISK_STOP_LOSS_NEAR_RATIO=0.8
# PORTFOLIO_RISK_LOOKBACK_DAYS=180
# PORTFOLIO_FX_UPDATE_ENABLED=true

# 동방재부 API 보완: 동방재부/Efinance/Akshare 의 동방재부 API 가 자주 실패할 때(RemoteDisconnected, 연결 끊김) 켜 보세요
# 켜면 NID 토큰과 무작위 User-Agent 를 넣어 동방재부의 요청 제한에 걸릴 가능성을 줄입니다
# ENABLE_EASTMONEY_PATCH=false

# Optional FXMacroData authorization; public USD data works without a key.
FXMACRODATA_API_KEY=
